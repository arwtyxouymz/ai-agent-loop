# ==============================================================================
# AI Agent Loop - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in the required values.
#   cp .env.example .env

# --- Authentication (one of these is required) ---
ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# --- Model ---
CLAUDE_MODEL=claude-opus-4-6

# --- Scaling ---
MAX_AGENTS=8
# Minimum ideas/tasks per agent before scaling up
MIN_IDEAS_PER_AGENT=2

# --- Project-specific commands (leave empty to skip) ---
# Command to check if the build is healthy (exit 0 = healthy)
BUILD_CHECK_CMD=
# Glob pattern for source files (used by orchestrator to detect codebase maturity)
SRC_GLOB=

# --- Orchestrator tuning ---
# Seconds between orchestrator check cycles
CHECK_INTERVAL=60
# Max agents to add per scaling cycle
SCALE_INCREMENT=2
# Conflict rate thresholds (percentage, 0-100)
CONFLICT_THRESHOLD_HIGH=40
CONFLICT_THRESHOLD_LOW=20
# Minimum number of commits before codebase is considered "mature"
MATURITY_COMMIT_THRESHOLD=10

# --- Agent tuning ---
# Seconds to sleep between agent loop iterations
AGENT_SLEEP=5
# Max consecutive failures before extended backoff
MAX_CONSECUTIVE_FAILURES=5
# Max log files to keep per agent
MAX_LOGS=50

# --- Host integration ---
# Auto-detected from project directory, override if needed
# HOST_PROJECT_DIR=
# Auto-generated from project dir name, override if needed
# COMPOSE_PROJECT_NAME=
# Auto-detected from host repo, override if needed
# DEFAULT_BRANCH=main

# --- Graceful shutdown ---
# stop_grace_period is set to 5m in docker-compose.yml
# To stop agents: .ai-agent-loop/orchestrator.sh stop
# To pause/resume: .ai-agent-loop/orchestrator.sh pause / resume
